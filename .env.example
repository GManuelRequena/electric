# Copiar a .env.local (local) o cargar en Vercel. NUNCA commitear valores reales.
ANTHROPIC_API_KEY=            # clave de la API de Claude (solo servidor)
APP_PASSWORD=                 # contraseña única del login del asistente
SESSION_SECRET=               # opcional: secreto para firmar la cookie (si falta se usa APP_PASSWORD)
TOPE_USD_MES=10               # tope de gasto mensual en USD (máximo 20)
# MODELO_IA=claude-sonnet-5-5 # modelo del chat
# MAX_TOKENS_RESPUESTA=2000   # límite de tokens por respuesta
# INDICE_NORMA=data/indice-norma.json
# USO_ARCHIVO=/ruta/uso.json  # dónde se acumula el gasto del mes
